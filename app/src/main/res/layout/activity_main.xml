<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEEEEE"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部：扫描输入框（PDA 扫码枪默认会填到这里并带回车） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="扫码到这里（自动发送到电脑）"
            android:textColor="#444"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_scan_input"
            android:inputType="text"
            android:background="@android:drawable/editbox_background"
            android:padding="14dp"
            android:textSize="22sp"
            android:textCursorDrawable="@null"
            android:imeOptions="actionSend"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- 最近发送记录（紧跟扫描框，方便看刚发的） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="最近发送"
            android:textColor="#444"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="60dp"
            android:padding="10dp"
            android:background="#FAFAFA"
            android:scrollbars="vertical"
            android:text="(无)"
            android:textColor="#666"
            android:textSize="13sp"
            android:gravity="top" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#CCCCCC" />

        <!-- 下面：服务器配置区 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="服务端配置"
            android:textColor="@color/purple_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- 服务器IP -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="电脑服务端 IP"
            android:textColor="#444"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etServerIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_server_ip"
            android:inputType="text"
            android:digits="0123456789."
            android:maxLength="15"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:textSize="18sp"
            android:text="192.168.1.100" />

        <!-- 端口 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="端口"
            android:textColor="#444"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etServerPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_server_port"
            android:inputType="number"
            android:maxLength="5"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:textSize="18sp"
            android:text="9800" />

        <!-- 连接按钮 -->
        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_connect"
            android:textSize="16sp" />

        <!-- 状态显示 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:text="@string/status_disconnected"
            android:textColor="@color/status_disconnected"
            android:textSize="14sp"
            android:gravity="center"
            android:background="#FAFAFA" />

    </LinearLayout>
</ScrollView>
